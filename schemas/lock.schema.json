      "type": "object",
      "properties": {
        "run": {
          "$ref": "package.schema.json#/$defs/service/properties/run"
        },
        "directory": {
          "$ref": "package.schema.json#/$defs/service/properties/directory"
        },
        "environment": {
          "$ref": "package.schema.json#/$defs/service/properties/environment"
        },
        "stdin": {
          "$ref": "package.schema.json#/$defs/service/properties/stdin"
        },
        "requires_mounts": {
          "$ref": "package.schema.json#/$defs/service/properties/requires_mounts"
        },
        "create_directories": {
          "$ref": "package.schema.json#/$defs/service/properties/create_directories"
        },
        "user": {
          "$ref": "package.schema.json#/$defs/service/properties/user"
        },
        "group": {
          "$ref": "package.schema.json#/$defs/service/properties/group"
        },
        "log": {
          "$ref": "package.schema.json#/$defs/service/properties/log"
        },
        "restart_delay_seconds": {
          "$ref": "package.schema.json#/$defs/service/properties/restart_delay_seconds"
        },
        "package": {
          "$ref": "common.schema.json#/$defs/packageName"
        },
        "capability": {
          "description": "Set when the service is owned through a capability.",
