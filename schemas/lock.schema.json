          "$ref": "common.schema.json#/$defs/capability"
        },
        "type": {
          "enum": [
            "symlink",
            "file"
          ]
        },
        "target": {
          "description": "Symlink target, or the package file copied.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "capability",
        "type",
        "target"
      ],
      "additionalProperties": false
    },
    "compiledService": {
      "title": "CompiledService",
