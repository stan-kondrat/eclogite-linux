{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devices",
  "type": "object",
  "properties": {
    "schema": {
      "const": "eclogite.devices/v0.1"
    },
    "devices": {
      "description": "Model names are unique across kinds.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/device"
      },
      "minProperties": 1
    }
  },
  "required": [
    "schema",
    "devices"
  ],
  "additionalProperties": false,
  "$defs": {
    "device": {
      "title": "DeviceModel",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "machine.schema.json#/$defs/deviceKind"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "description": "Config the driver needs, keyed by capability. It applies only when the\nsystem has that capability; a device never adds a package.\n@example { \"linux\": { \"CONFIG_RTC_DRV_PL031\": \"y\" } }",
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/config"
          },
          "minProperties": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
