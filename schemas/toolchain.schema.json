{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolchain",
  "description": "The builder image. Eclogite never builds a toolchain.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "eclogite.toolchain/v0.1"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "provider": {
      "description": "OPEN(13): a constant.",
      "const": "linux-libre-vm"
    },
    "release": {
      "description": "Release of the builder image: a linux-libre-vm release tag, such as `v0.4.0`. OPEN(13): or `\"unreleased\"`.",
      "type": "string",
      "minLength": 1
    },
    "builder": {
      "type": "object",
      "properties": {
        "hosts": {
          "description": "Build host architectures the builder image exists for.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "images": {
          "description": "Build host → the dev image and kernel the builder VM boots, as release assets. A lock against a release needs the entry of its build host.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/builderImage"
          }
        },
        "resources": {
          "description": "Default builder VM size; `compatible.build` may raise it.",
          "$ref": "common.schema.json#/$defs/resources"
        }
      },
      "required": [
        "hosts",
        "resources"
      ],
      "additionalProperties": false
    },
    "targets": {
      "description": "Target triplet → its cross toolchain and sysroot. OPEN(9)",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(-[a-z0-9_]+){2,3}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/target"
      },
      "minProperties": 1
    },
    "compilers": {
      "description": "In fallback order, each mapped to the manifest tools it needs.\nOPEN(11): the order is the order of the keys in the object.",
      "type": "object",
      "properties": {
        "gcc": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._+-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "clang": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._+-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "tools": {
      "description": "The tool manifest snapshot: what packages may name as `builder:<tool>`.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._+-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "required": [
    "schema",
    "name",
    "provider",
    "release",
    "builder",
    "targets",
    "compilers",
    "tools"
  ],
  "additionalProperties": false,
  "$defs": {
    "status": {
      "enum": [
        "planned"
      ]
    },
    "tool": {
      "title": "Tool",
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "description": "A Git URL. OPEN(13): or `\"tarball\"`.",
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/gitRevision"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "target": {
      "title": "Target",
      "description": "A cross toolchain and sysroot. `archives` gives the release asset per build host; a lock against a release needs the entry of its build host. `planned`: the builder image does not ship it yet, and a system that needs it fails.",
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "archives": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/asset"
          }
        }
      },
      "additionalProperties": false
    },
    "builderImage": {
      "title": "BuilderImage",
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/asset"
        },
        "kernel": {
          "$ref": "#/$defs/asset"
        }
      },
      "required": [
        "image",
        "kernel"
      ],
      "additionalProperties": false
    },
    "asset": {
      "title": "ReleaseAsset",
      "description": "A file of the release, as published, with its SHA-256 from the release checksums.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
