{
  "schema": "eclogite.package/v0.1",
  "name": "dhcpcd",
  "version": "10.3.2",
  "source": {
    "type": "git",
    "url": "https://github.com/NetworkConfiguration/dhcpcd.git",
    "revision": "243ad84ac67a87d631ff7eb83b2eed2727acebb5"
  },
  "provides": ["dhcp-client"],
  // Its configure is a hand-written script, not autoconf
  "builder": "configure",
  "dependencies": {
    "run": ["libc", "init"]
  },
  "services": {
    // IPv4 DHCP on all interfaces; -B keeps it in the foreground for runsv
    "dhcpcd": {
      "run": ["dhcpcd", "-B", "-4", "-q"]
    }
  },
  "tests": {
    // hooks are tests/<name>.sh, run in the booted guest
    "dhcp": {
      "when": { "devices": { "has": "network" } },
      "needs": ["iproute2"],
      "timeout_seconds": 60
    }
  },
  "arguments": {
    "configure": [
      "--prefix=/usr",
      "--sysconfdir=/etc",
      "--datadir=/usr/share",
      "--libexecdir=/usr/libexec",
      "--dbdir=/var/db/dhcpcd",
      "--rundir=/var/run/dhcpcd"
    ]
  }
}
