# What every Eclogite system needs on top of allnoconfig. Device drivers,
# filesystems and consoles come from the resolved options: what dependents
# (base-files, runit, ...), the software and the machine's devices require.

# The root is an initramfs (gzip), or a disk the machine's devices name
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Programs: ELF binaries and #! scripts
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Consoles and logins
CONFIG_TTY=y
CONFIG_PRINTK=y

# Sockets: Unix sockets, IPv4, raw packets for DHCP clients, loopback
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y

# System V IPC, which some programs expect
CONFIG_SYSVIPC=y

# Menus that gate drivers the machines' devices require; allnoconfig closes
# them, and Kconfig then drops the drivers silently
CONFIG_VIRTIO_MENU=y
CONFIG_BLK_DEV=y
