{
  "schema": "eclogite.package/v0.1",
  "name": "gzip",
  "version": "1.13",
  "source": {
    "type": "git",
    "url": "https://git.savannah.gnu.org/git/gzip.git",
    "revision": "0ff67062bc123d07dfb1f05c78231107aa9d1869"
  },
  "builder": "configure",
  "dependencies": {
    "build": ["gnulib"]
  },
  "arguments": {
    "bootstrap": "gnulib",
    "configure": ["--prefix=/usr", "--disable-nls", "--disable-silent-rules"]
  }
}
