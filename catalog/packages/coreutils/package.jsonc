{
  "schema": "eclogite.package/v0.1",
  "name": "coreutils",
  "version": "9.6",
  "source": {
    "type": "git",
    "url": "https://git.savannah.gnu.org/git/coreutils.git",
    "revision": "e2a405981ff5441dcfb217797699c94968218aca"
  },
  // The reference build has 01-glib-acl-ch-rename.patch; migration is intentionally pending.
  "provides": ["core-utils"],
  "builder": "configure",
  "dependencies": {
    "build": ["gnulib"],
    "link": ["libc"],
    "run": ["libc"]
  },
  "arguments": {
    "bootstrap": "gnulib",
    "configure": ["--prefix=/usr", "--disable-nls", "--disable-silent-rules"]
  }
}
