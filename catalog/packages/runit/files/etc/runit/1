#!/bin/sh
# runit stage 1: one-time system initialization.
# The root is read-only. Everything writable is tmpfs; /etc/fstab is
# generated by the image step from the software profile ("root.tmpfs") and
# every package's "mounts", with "nofail" for optional ones.

PATH=/bin

# Kernel filesystems
mount -t proc proc /proc -o nosuid,noexec,nodev
mount -t sysfs sysfs /sys -o nosuid,noexec,nodev
mount -t devtmpfs devtmpfs /dev -o nosuid,noexec,mode=0755
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts -o nosuid,noexec,gid=5,mode=0620
mount -t tmpfs tmpfs /dev/shm -o nosuid,noexec,nodev,mode=1777

# /run, /tmp and package mounts such as host-share's /mnt/shared
mount -a

# runit's control files and every service's supervise directory are links
# into /run (generated with the services), so they must exist before stage 2
mkdir -p /run/runit/supervise
touch /run/runit/stopit
chmod 0 /run/runit/stopit

cat /etc/hostname > /proc/sys/kernel/hostname

# loopback; ip is in the network meta-package and may be absent
ip link set lo up 2>/dev/null || true

exit 0
