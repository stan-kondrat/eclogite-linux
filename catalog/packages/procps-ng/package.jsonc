{
  "schema": "eclogite.package/v0.1",
  "name": "procps-ng",
  "version": "4.0.5",
  "source": {
    "type": "git",
    "url": "https://gitlab.com/procps-ng/procps.git",
    "revision": "f46b2f7929cdfe2913ed0a7f585b09d6adbf994e"
  },
  // The reference build has 01-capnames-portable-echo.patch; migration is pending.
  "builder": "configure",
  "arguments": {
    "bootstrap": "autoreconf",
    "configure": [
      "--prefix=/usr",
      "--disable-nls",
      "--disable-silent-rules",
      "--disable-liblastlog2",
      // ncurses is not packaged: nothing in the guest is copied from the builder
      "--without-ncurses"
    ]
  }
}
