{
  "schema": "eclogite.package/v0.1",
  "name": "tar",
  "version": "1.35",
  "source": {
    "type": "git",
    "url": "https://git.savannah.gnu.org/git/tar.git",
    "revision": "e545d446dfe6564265cdf4186641ee76f4acc7fa"
  },
  // The pinned paxutils nested submodule must be represented before fetching.
  "builder": "configure",
  "dependencies": {
    "build": ["gnulib"]
  },
  "arguments": {
    "bootstrap": "gnulib",
    "configure": ["--prefix=/usr", "--disable-nls", "--disable-silent-rules"]
  }
}
