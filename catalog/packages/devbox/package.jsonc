{
  "schema": "eclogite.package/v0.1",
  "name": "devbox",
  "version": "1",
  // The devbox's own package: the sshd service with its host keys on the
  // state volume, the login environment and sshd settings, and the tools
  // linux-devbox-vm installs beyond the Theia system (git, less, CA
  // certificates).
  "source": { "type": "none" },
  "builder": "files",
  "compatible": {
    // home, workspace and npm cache live on the share
    "machine": { "all": [{ "devices": { "has": "shared-directory" } }, { "devices": { "has": "network" } }] }
  },
  "dependencies": {
    "run": ["openssh", "git", "less", "ca-certificates", "host-share", "init"]
  },
  "services": {
    // ssh-keygen -A -f writes missing host keys under /var/lib/devbox/etc/ssh
    // (the state volume, so they survive recreate). sshd reads only the
    // devbox configuration: -D keeps it in the foreground for the
    // supervisor, -e logs to stderr.
    "sshd": {
      "run": ["sh", "-c", "ssh-keygen -A -f /var/lib/devbox && exec /bin/sshd -D -e -f /etc/ssh/devbox_sshd_config"],
      "create_directories": [{ "path": "/var/lib/devbox/etc/ssh", "mode": "0700" }, "/run/sshd"]
    }
  },
  "tests": {
    // the guest has no nc or curl: the test reads the banner with node
    "ssh-22": { "needs": ["nodejs"], "timeout_seconds": 30 }
  },
  "arguments": {
    "files": {
      // base-files has no /etc/profile yet: this one sources /etc/profile.d
      "files/profile": "/etc/profile",
      // PATH, npm cache and TMPDIR on the share, XDG_RUNTIME_DIR,
      // NX_DISABLE_DB (its SQLite locking fails on 9p), PUPPETEER_SKIP_DOWNLOAD
      "files/profile.sh": "/etc/profile.d/devbox.sh",
      // the whole sshd configuration: password login, host keys on the state
      // volume, SetEnv BASH_ENV so `ssh host CMD` gets the login environment
      "files/sshd.conf": "/etc/ssh/devbox_sshd_config"
    },
    "symlinks": {
      // programs the user installs later (npm -g) start with #!/usr/bin/env node
      "/usr/bin/env": "/bin/env",
      // `pager` is less, as in linux-devbox-vm
      "/bin/pager": "less"
    }
  }
}
