{
  "schema": "eclogite.package/v0.1",
  "name": "grep",
  "version": "3.11",
  "source": {
    "type": "git",
    "url": "https://git.savannah.gnu.org/git/grep.git",
    "revision": "f951840aa510277fe48e5f2579a98f517246ea86"
  },
  "builder": "configure",
  "dependencies": {
    "build": ["gnulib"]
  },
  "arguments": {
    "bootstrap": "gnulib",
    "configure": ["--prefix=/usr", "--disable-nls", "--disable-silent-rules"]
  }
}
