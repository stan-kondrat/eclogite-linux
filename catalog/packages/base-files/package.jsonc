{
  "schema": "eclogite.package/v0.1",
  "name": "base-files",
  "version": "1",
  // The filesystem skeleton every system needs: directories, users and
  // groups. Programs live only in /bin: builders move them there
  // and rewrite #!/usr/bin/... interpreters, so there is no /usr/bin.
  // /etc/hostname and /etc/fstab are generated by the image step from the
  // software profile's "root" and every package's "mounts"; the console
  // login, init scripts and host share are packages of their own. Reference
  // templates will later move into files/.
  "source": {
    "type": "none"
  },
  "builder": "files",
  "dependencies": {
    "run": [
      // the read-only root needs tmpfs for /run, /tmp and /dev/shm, and
      // devtmpfs; on another kernel family this entry does not apply
      { "package": "linux", "when": { "os": { "eq": "linux" } },
        "config": { "CONFIG_TMPFS": "y", "CONFIG_DEVTMPFS": "y" } }
    ]
  },
  "arguments": {
    // the root is read-only: DHCP clients write the resolver list to /run
    "symlinks": {
      "/etc/resolv.conf": "../run/resolv.conf"
    }
  }
}
