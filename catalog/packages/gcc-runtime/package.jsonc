{
  "schema": "eclogite.package/v0.1",
  "name": "gcc-runtime",
  "version": "15.3.0",
  // GCC's target runtime libraries only: libgcc_s, libstdc++, libatomic.
  // The compiler itself is never installed in a guest.
  //
  // Decided 2026-11-27: copied from the pinned cross toolchain instead of
  // built from source. Building the target libraries means building gcc
  // itself, which needs GMP, MPFR and MPC (not in the v0.4.0 dev image), and
  // the toolchain's copies are built from the same gcc revision: the
  // builder:gcc dependency puts that revision in this package's key. C++
  // programs need the GLIBCXX_*/GCC_* symbol versions of the compiler that
  // linked them, which is exactly this gcc.
  "source": { "type": "none" },
  // libgcc_s is the compiler runtime and unwinder, libstdc++ the C++ library
  "provides": ["cc-runtime", "c++-runtime"],
  "compatible": {
    "build": { "compiler": { "eq": "gcc" } }
  },
  "builder": "files",
  "dependencies": {
    "build": ["builder:gcc"],
    "link": ["libc"]
  },
  "arguments": {
    "hooks": {
      // the shared objects from the toolchain into /lib
      "install": ["install"]
    }
  }
}
