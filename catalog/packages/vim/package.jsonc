{
  "schema": "eclogite.package/v0.1",
  "name": "vim",
  "version": "9.2.0725",
  "source": {
    "type": "git",
    "url": "https://github.com/vim/vim.git",
    "revision": "d22ff1c955ff87e8273210eae125aab0e85b6c30"
  },
  // The reference cross build creates a termcap stub; model it as a hook later.
  "provides": {
    "vi": { "symlinks": { "/bin/vi": "vim" } }
  },
  "builder": "configure",
  // Runs wherever a C library does: "libc" is a capability, so the platform's
  // provider is used (glibc on Linux)
  "dependencies": {
    "link": ["libc"],
    "run": ["libc"]
  },
  "arguments": {
    "configure": [
      "--prefix=/usr",
      "--with-features=tiny",
      "--disable-gui",
      "--without-x",
      "--disable-netbeans",
      "--disable-channel",
      "--disable-gpm",
      "--disable-acl",
      "--disable-nls",
      "--disable-smack",
      "--disable-selinux",
      "--enable-gui=no"
    ]
  }
}
