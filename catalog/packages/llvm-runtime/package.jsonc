{
  "schema": "eclogite.package/v0.1",
  "name": "llvm-runtime",
  "version": "23.1.3",
  // LLVM's target runtimes: compiler-rt builtins and libunwind (the compiler
  // runtime and unwinder), libc++ and libc++abi (the C++ library). The
  // alternative to gcc-runtime, chosen with "providers":
  // { "cc-runtime": "llvm-runtime", "c++-runtime": "llvm-runtime" }.
  "source": {
    "type": "git",
    "url": "https://github.com/llvm/llvm-project.git",
    "revision": "0d261d1ca552c95a8f007e061c787ac7132fbcbc"
  },
  // libc++ must match the clang that compiles against it
  "matches_builder_tool": "clang",
  "provides": ["cc-runtime", "c++-runtime"],
  "compatible": {
    "build": { "compiler": { "eq": "clang" } }
  },
  "builder": "cmake",
  "dependencies": {
    "build": ["builder:clang", "builder:lld", "builder:cmake", "builder:ninja"],
    "link": ["libc"],
    "run": ["libc"]
  },
  "arguments": {
    // the runtimes-only build, not the compiler
    "directory": "runtimes",
    "cmake": [
      "-DLLVM_ENABLE_RUNTIMES=compiler-rt;libunwind;libcxxabi;libcxx",
      "-DCMAKE_BUILD_TYPE=Release",
      "-DCMAKE_INSTALL_PREFIX=/usr",
      "-DCOMPILER_RT_BUILD_BUILTINS=ON",
      "-DCOMPILER_RT_BUILD_SANITIZERS=OFF",
      "-DCOMPILER_RT_BUILD_XRAY=OFF",
      "-DCOMPILER_RT_BUILD_LIBFUZZER=OFF",
      "-DCOMPILER_RT_BUILD_PROFILE=OFF",
      "-DLIBCXXABI_USE_LLVM_UNWINDER=ON",
      "-DLIBCXXABI_USE_COMPILER_RT=ON",
      "-DLIBCXX_USE_COMPILER_RT=ON",
      "-DLIBUNWIND_USE_COMPILER_RT=ON"
    ],
    // C++ headers stay: packages that link c++-runtime compile against them;
    // the software profile's image policy can still exclude /usr/include
    "remove": ["**/*.a"]
  },
  "variants": [
    { "when": { "libc": { "eq": "musl" } },
      "arguments": { "cmake": ["-DLIBCXX_HAS_MUSL_LIBC=ON"] } }
  ]
}
