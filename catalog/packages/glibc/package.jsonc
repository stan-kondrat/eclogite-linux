{
  "schema": "eclogite.package/v0.1",
  "name": "glibc",
  "version": "2.43",
  // The guest's C library: the loader, shared libraries, NSS modules,
  // ldconfig and getent.
  //
  // Decided 2026-11-27: copied from the pinned cross toolchain's sysroot, not
  // built from source. The linux-libre-vm dev image is the base builder
  // environment, and every guest program is linked against this sysroot, so
  // shipping its own libraries is the closest ABI match; the builder:glibc
  // dependency puts the toolchain's glibc revision in this package's key.
  // Headers, static libraries, start files and gconv modules stay in the
  // sysroot.
  "source": { "type": "none" },
  "provides": ["libc"],
  "compatible": {
    "target": {
      "all": [
        { "os": { "eq": "linux" } },
        { "libc": { "eq": "glibc" } }
      ]
    }
  },
  "builder": "files",
  "dependencies": {
    "build": ["builder:glibc"],
    // the unwinder: pthread_cancel and backtrace load it at runtime
    "run": ["cc-runtime"]
  },
  "arguments": {
    "hooks": {
      "install": ["install"]
    }
  }
}
