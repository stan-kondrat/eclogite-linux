{
  "schema": "eclogite.package/v0.1",
  "name": "zlib",
  "version": "1.3.2",
  // Release tag v1.3.2 (peeled commit), chosen 2026-11-01
  "source": {
    "type": "git",
    "url": "https://github.com/madler/zlib.git",
    "revision": "da607da739fa6047df13e66a2af6b8bec7c2a498"
  },
  // Its configure is a hand-written script, not autoconf, and it rejects
  // unknown options such as --host: the builder must pass the toolchain
  // through CC and AR only (unverified until the builder exists)
  "builder": "configure",
  "dependencies": {
    "link": ["libc"],
    "run": ["libc"]
  },
  "arguments": {
    "configure": ["--prefix=/usr", "--shared"],
    "remove": ["/usr/share/man"]
  }
}
