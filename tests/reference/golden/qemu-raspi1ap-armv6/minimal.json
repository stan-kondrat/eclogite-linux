{
  "machine": "qemu-raspi1ap-armv6",
  "software": "minimal",
  "abi": "linux-gnu",
  "triplet": "armv6-linux-gnueabihf",
  "closure": [
    "base",
    "base-files",
    "linux-libre",
    "glibc",
    "gcc-runtime",
    "runit",
    "bash",
    "coreutils",
    "util-linux",
    "console-login"
  ],
  "choices": {
    "c++-runtime": {
      "provider": "gcc-runtime",
      "reason": "already chosen"
    },
    "cc-runtime": {
      "provider": "gcc-runtime",
      "reason": "default"
    },
    "core-utils": {
      "provider": "coreutils",
      "reason": "default"
    },
    "init": {
      "provider": "runit",
      "reason": "default"
    },
    "kernel": {
      "provider": "linux-libre",
      "reason": "default"
    },
    "libc": {
      "provider": "glibc",
      "reason": "default"
    },
    "linux": {
      "provider": "linux-libre",
      "reason": "already chosen"
    },
    "sh": {
      "provider": "bash",
      "reason": "default"
    },
    "system-utils": {
      "provider": "util-linux",
      "reason": "default"
    }
  },
  "compilers": {
    "bash": "gcc",
    "coreutils": "gcc",
    "gcc-runtime": "gcc",
    "glibc": "gcc",
    "linux-libre": "gcc",
    "runit": "gcc",
    "util-linux": "gcc"
  },
  "config": {
    "linux-libre": {
      "CONFIG_DEVTMPFS": {
        "value": "y",
        "source": "base-files"
      },
      "CONFIG_I2C_BCM2835": {
        "value": "y",
        "source": "device bcm2835-i2c"
      },
      "CONFIG_MMC": {
        "value": "y",
        "source": "device sd-mmc"
      },
      "CONFIG_MMC_BCM2835": {
        "value": "y",
        "source": "device sd-mmc"
      },
      "CONFIG_PINCTRL_BCM2835": {
        "value": "y",
        "source": "device bcm2835-gpio"
      },
      "CONFIG_PROC_FS": {
        "value": "y",
        "source": "runit"
      },
      "CONFIG_SERIAL_8250": {
        "value": "y",
        "source": "device bcm2835-aux"
      },
      "CONFIG_SERIAL_8250_BCM2835AUX": {
        "value": "y",
        "source": "device bcm2835-aux"
      },
      "CONFIG_SERIAL_AMBA_PL011": {
        "value": "y",
        "source": "device pl011"
      },
      "CONFIG_SERIAL_AMBA_PL011_CONSOLE": {
        "value": "y",
        "source": "device pl011"
      },
      "CONFIG_SPI_BCM2835": {
        "value": "y",
        "source": "device bcm2835-spi"
      },
      "CONFIG_SYSFS": {
        "value": "y",
        "source": "runit"
      },
      "CONFIG_TMPFS": {
        "value": "y",
        "source": "base-files"
      },
      "CONFIG_UNIX98_PTYS": {
        "value": "y",
        "source": "runit"
      },
      "CONFIG_USB": {
        "value": "y",
        "source": "device usb-host"
      },
      "CONFIG_USB_DWC2": {
        "value": "y",
        "source": "device usb-host"
      }
    }
  },
  "owned_files": {
    "/bin/getty": "util-linux:system-utils",
    "/bin/sh": "bash:sh"
  },
  "tests": []
}
