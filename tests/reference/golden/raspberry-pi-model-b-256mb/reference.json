{
  "machine": "raspberry-pi-model-b-256mb",
  "software": "reference",
  "abi": "linux-gnu",
  "triplet": "armv6-linux-gnueabihf",
  "closure": [
    "reference-system",
    "base",
    "base-files",
    "linux-libre",
    "glibc",
    "gcc-runtime",
    "runit",
    "bash",
    "coreutils",
    "util-linux",
    "console-login",
    "gnu-utils",
    "grep",
    "sed",
    "gawk",
    "findutils",
    "diffutils",
    "gzip",
    "tar",
    "procps-ng",
    "network",
    "iproute2",
    "dhcpcd",
    "editor",
    "vim"
  ],
  "choices": {
    "c++-runtime": {
      "provider": "gcc-runtime",
      "reason": "already chosen"
    },
    "cc-runtime": {
      "provider": "gcc-runtime",
      "reason": "default"
    },
    "core-utils": {
      "provider": "coreutils",
      "reason": "default"
    },
    "dhcp-client": {
      "provider": "dhcpcd",
      "reason": "default"
    },
    "init": {
      "provider": "runit",
      "reason": "default"
    },
    "ip": {
      "provider": "iproute2",
      "reason": "default"
    },
    "kernel": {
      "provider": "linux-libre",
      "reason": "default"
    },
    "libc": {
      "provider": "glibc",
      "reason": "default"
    },
    "linux": {
      "provider": "linux-libre",
      "reason": "already chosen"
    },
    "sh": {
      "provider": "bash",
      "reason": "default"
    },
    "system-utils": {
      "provider": "util-linux",
      "reason": "default"
    },
    "utils": {
      "provider": "gnu-utils",
      "reason": "default"
    },
    "vi": {
      "provider": "vim",
      "reason": "default"
    }
  },
  "compilers": {
    "bash": "gcc",
    "coreutils": "gcc",
    "dhcpcd": "gcc",
    "diffutils": "gcc",
    "findutils": "gcc",
    "gawk": "gcc",
    "gcc-runtime": "gcc",
    "glibc": "gcc",
    "grep": "gcc",
    "gzip": "gcc",
    "iproute2": "gcc",
    "linux-libre": "gcc",
    "procps-ng": "gcc",
    "runit": "gcc",
    "sed": "gcc",
    "tar": "gcc",
    "util-linux": "gcc",
    "vim": "gcc"
  },
  "config": {
    "linux-libre": {
      "CONFIG_DEVTMPFS": {
        "value": "y",
        "source": "base-files"
      },
      "CONFIG_MMC": {
        "value": "y",
        "source": "device sd-card"
      },
      "CONFIG_MMC_BCM2835": {
        "value": "y",
        "source": "device sd-card"
      },
      "CONFIG_PROC_FS": {
        "value": "y",
        "source": "runit"
      },
      "CONFIG_SERIAL_AMBA_PL011": {
        "value": "y",
        "source": "device pl011"
      },
      "CONFIG_SERIAL_AMBA_PL011_CONSOLE": {
        "value": "y",
        "source": "device pl011"
      },
      "CONFIG_SYSFS": {
        "value": "y",
        "source": "runit"
      },
      "CONFIG_TMPFS": {
        "value": "y",
        "source": "base-files"
      },
      "CONFIG_UNIX98_PTYS": {
        "value": "y",
        "source": "runit"
      },
      "CONFIG_USB": {
        "value": "y",
        "source": "device usb-2.0"
      },
      "CONFIG_USB_DWC2": {
        "value": "y",
        "source": "device usb-2.0"
      },
      "CONFIG_USB_NET_SMSC95XX": {
        "value": "y",
        "source": "device ethernet"
      },
      "CONFIG_USB_USBNET": {
        "value": "y",
        "source": "device ethernet"
      }
    }
  },
  "owned_files": {
    "/bin/getty": "util-linux:system-utils",
    "/bin/sh": "bash:sh",
    "/bin/vi": "vim:vi"
  },
  "tests": [
    "dhcpcd:dhcp"
  ]
}
