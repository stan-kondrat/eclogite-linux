  "compilers": {
    "bash": "gcc",
    "coreutils": "gcc",
    "dhcpcd": "gcc",
    "diffutils": "gcc",
    "findutils": "gcc",
    "gawk": "gcc",
    "gcc-runtime": "gcc",
    "glibc": "gcc",
    "grep": "gcc",
    "gzip": "gcc",
    "iproute2": "gcc",
    "linux-libre": "gcc",
    "procps-ng": "gcc",
    "runit": "gcc",
    "sed": "gcc",
    "tar": "gcc",
    "util-linux": "gcc",
    "vim": "gcc"
