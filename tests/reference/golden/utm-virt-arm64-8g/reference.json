  "config": {
    "linux-libre": {
      "CONFIG_9P_FS": {
        "value": "y",
        "source": "host-share"
      },
      "CONFIG_DEVTMPFS": {
        "value": "y",
        "source": "base-files"
      },
      "CONFIG_NET_9P": {
        "value": "y",
        "source": "implied by CONFIG_9P_FS"
      },
      "CONFIG_NET_9P_VIRTIO": {
        "value": "y",
        "source": "device virtio-9p-device"
      },
      "CONFIG_PROC_FS": {
        "value": "y",
        "source": "runit"
      },
      "CONFIG_RTC_CLASS": {
        "value": "y",
        "source": "device pl031"
      },
      "CONFIG_RTC_DRV_PL031": {
        "value": "y",
        "source": "device pl031"
      },
      "CONFIG_RTC_HCTOSYS": {
        "value": "y",
        "source": "device pl031"
      },
      "CONFIG_SERIAL_AMBA_PL011": {
        "value": "y",
        "source": "device pl011"
      },
      "CONFIG_SERIAL_AMBA_PL011_CONSOLE": {
        "value": "y",
        "source": "device pl011"
      },
      "CONFIG_SYSFS": {
        "value": "y",
        "source": "runit"
      },
      "CONFIG_TMPFS": {
        "value": "y",
        "source": "base-files"
      },
      "CONFIG_UNIX98_PTYS": {
        "value": "y",
        "source": "runit"
      },
      "CONFIG_VIRTIO": {
        "value": "y",
        "source": "implied by CONFIG_VIRTIO_MMIO"
      },
      "CONFIG_VIRTIO_BLK": {
        "value": "y",
        "source": "device virtio-blk-device"
      },
      "CONFIG_VIRTIO_MMIO": {
        "value": "y",
        "source": "device virtio-blk-device"
      },
      "CONFIG_VIRTIO_NET": {
        "value": "y",
        "source": "device virtio-net-device"
      }
    }
  },
  "owned_files": {
    "/bin/getty": "util-linux:system-utils",
    "/bin/sh": "bash:sh",
    "/bin/vi": "vim:vi"
  },
  "tests": [
    "linux-libre:clock",
    "dhcpcd:dhcp"
  ]
}
